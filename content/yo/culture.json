{
  "language": "yo",
  "proverbs": [
    {
      "id": "ajo",
      "text": "Àjò kì í dùn kí onílé má relé.",
      "literal": "A journey is never so sweet that the traveller doesn't return home.",
      "meaning": "However far you go, home still calls you back.",
      "audioKey": "yo_owe_ajo"
    },
    {
      "id": "igi_kan",
      "text": "Igi kan kì í dágbó ṣe.",
      "literal": "One tree does not make a forest.",
      "meaning": "We are stronger together than alone.",
      "audioKey": "yo_owe_igi_kan"
    },
    {
      "id": "ile_la_n_wo",
      "text": "Ilé là ń wò, ká tó sọmọ lórúkọ.",
      "literal": "We look at the home before we name the child.",
      "meaning": "A Yorùbá name tells the story of the family and moment a child is born into.",
      "audioKey": "yo_owe_ile_la_n_wo"
    },
    {
      "id": "omode_owo",
      "text": "Bí ọmọdé bá mọ ọwọ́ wẹ̀, á bá àgbà jẹun.",
      "literal": "If a child knows how to wash their hands, they will eat with the elders.",
      "meaning": "Good conduct earns a young person a place among elders.",
      "audioKey": "yo_owe_omode_owo"
    },
    {
      "id": "owo_omode",
      "text": "Ọwọ́ ọmọdé kò tó pẹpẹ, tàgbàlagbà kò wọ akèrègbè.",
      "literal": "A child's hand can't reach the high shelf; an elder's hand can't fit into the gourd.",
      "meaning": "Young and old each have something the other needs.",
      "audioKey": "yo_owe_owo_omode"
    },
    {
      "id": "ikoko",
      "text": "Ìkòkò tí yóò jẹ ata, ìdí rẹ̀ á gbóná.",
      "literal": "The pot that will cook pepper stew must bear the heat underneath.",
      "meaning": "Success comes through endurance.",
      "audioKey": "yo_owe_ikoko"
    },
    {
      "id": "oro_pupo",
      "text": "Ọ̀rọ̀ púpọ̀ kò kún agbọ̀n.",
      "literal": "Many words do not fill a basket.",
      "meaning": "Actions matter more than talk.",
      "audioKey": "yo_owe_oro_pupo"
    },
    {
      "id": "ona_kan",
      "text": "Ọ̀nà kan ò wọ ọjà.",
      "literal": "Not just one road leads to the market.",
      "meaning": "There is more than one way to reach a goal.",
      "audioKey": "yo_owe_ona_kan"
    },
    {
      "id": "iwa",
      "text": "Ìwà lẹ̀sìn.",
      "literal": "Character is religion.",
      "meaning": "How you treat people is the truest sign of your faith.",
      "audioKey": "yo_owe_iwa"
    },
    {
      "id": "eyin",
      "text": "Ẹyin lọ̀rọ̀, bí ó bá balẹ̀, fífọ́ ní í fọ́.",
      "literal": "Words are eggs; once they fall, they break.",
      "meaning": "Think before you speak. Words can't be taken back.",
      "audioKey": "yo_owe_eyin"
    },
    {
      "id": "oyin",
      "text": "Ẹni tí yóò jẹ oyin inú àpáta kì í wo ẹnu àáké.",
      "literal": "Whoever would eat honey from inside the rock doesn't fear the axe's edge.",
      "meaning": "Great rewards take courage and effort.",
      "audioKey": "yo_owe_oyin"
    },
    {
      "id": "ile_eko",
      "text": "Ilé lẹ̀kọ́ ti ń bẹ̀rẹ̀ kí ó tó dé ìta.",
      "literal": "Education starts at home before it reaches the outside world.",
      "meaning": "Children first learn their values from family.",
      "audioKey": "yo_owe_ile_eko"
    },
    {
      "id": "omo_iya",
      "text": "Ọmọ tí kò gbọ́ tìyá, á gbọ́ tayé.",
      "literal": "A child who won't listen to their mother will listen to the world.",
      "meaning": "Ignore loving advice and life will teach you harder lessons.",
      "audioKey": "yo_owe_omo_iya"
    },
    {
      "id": "agba_loja",
      "text": "Àgbà kì í wà lọ́jà, kí orí ọmọ títun wọ́.",
      "literal": "An elder doesn't stay in the market and let a baby's head hang crooked.",
      "meaning": "Elders are responsible for guiding and protecting the young.",
      "audioKey": "yo_owe_agba_loja"
    }
  ],
  "names": [
