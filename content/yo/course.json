{
  "language": "yo",
  "lexicon": {
    "e_kaaro": {
      "text": "Ẹ káàárọ̀",
      "english": "Good morning",
      "audioKey": "yo_e_kaaro",
      "note": "Respectful: for parents, grandparents and anyone older."
    },
    "kaaro": {
      "text": "Káàárọ̀",
      "english": "Good morning (to a friend)",
      "audioKey": "yo_kaaro",
      "note": "Without the Ẹ, it's for friends, siblings your age and younger people."
    },
    "e_kaasan": {
      "text": "Ẹ káàsán",
      "english": "Good afternoon",
      "audioKey": "yo_e_kaasan"
    },
    "e_kaale": {
      "text": "Ẹ káalẹ́",
      "english": "Good evening",
      "audioKey": "yo_e_kaale"
    },
    "o_daaro": {
      "text": "Ó dàárọ̀",
      "english": "Good night",
      "audioKey": "yo_o_daaro",
      "note": "Literally “until the morning”."
    },
    "e_se": {
      "text": "Ẹ ṣé",
      "english": "Thank you",
      "audioKey": "yo_e_se",
      "note": "Respectful “thank you”, for elders."
    },
    "o_se": {
      "text": "O ṣé",
      "english": "Thank you (to a friend)",
      "audioKey": "yo_o_se",
      "note": "For friends and anyone younger than you."
    },
    "e_jowo": {
      "text": "Ẹ jọ̀wọ́",
      "english": "Please",
      "audioKey": "yo_e_jowo"
    },
    "e_ku_ise": {
      "text": "Ẹ kú iṣẹ́",
      "english": "Well done (for your work)",
      "audioKey": "yo_e_ku_ise",
      "note": "Said to someone who is working or has just finished. Yorùbá has a greeting for almost every situation."
    },
    "baba": {
      "text": "Bàbá",
      "english": "Father",
      "audioKey": "yo_baba"
    },
    "iya": {
      "text": "Ìyá",
      "english": "Mother",
      "audioKey": "yo_iya"
    },
    "baba_agba": {
      "text": "Bàbá àgbà",
      "english": "Grandfather",
      "audioKey": "yo_baba_agba",
      "note": "Literally “elder father”."
    },
    "iya_agba": {
      "text": "Ìyá àgbà",
      "english": "Grandmother",
      "audioKey": "yo_iya_agba",
      "note": "Literally “elder mother”."
    },
    "egbon": {
      "text": "Ẹ̀gbọ́n",
      "english": "Older sibling or cousin",
      "audioKey": "yo_egbon",
      "note": "Yorùbá cares more about who is older than about brother or sister."
    },
    "aburo": {
      "text": "Àbúrò",
      "english": "Younger sibling or cousin",
      "audioKey": "yo_aburo"
    },
    "beeni": {
      "text": "Bẹ́ẹ̀ni",
      "english": "Yes",
      "audioKey": "yo_beeni"
    },
    "rara": {
      "text": "Rárá",
      "english": "No",
      "audioKey": "yo_rara"
    },
    "se_alaafia_ni": {
      "text": "Ṣé àlàáfíà ni?",
      "english": "Are you well?",
      "audioKey": "yo_se_alaafia_ni"
    },
    "alaafia_ni": {
      "text": "Àlàáfíà ni",
      "english": "I'm well (all is well)",
      "audioKey": "yo_alaafia_ni"
    },
    "mo_wa_daadaa": {
      "text": "Mo wà dáadáa",
      "english": "I'm fine",
      "audioKey": "yo_mo_wa_daadaa"
    },
    "o_dabo": {
      "text": "Ó dàbọ̀",
      "english": "Goodbye",
      "audioKey": "yo_o_dabo"
    },
    "kaaro_iya_agba": {
      "text": "Ẹ káàárọ̀, ìyá àgbà",
      "english": "Good morning, Grandma",
      "audioKey": "yo_kaaro_iya_agba",
      "note": "Traditionally, girls and women kneel and boys and men bow or prostrate when greeting elders."
    },
    "kaale_baba_agba": {
      "text": "Ẹ káalẹ́, bàbá àgbà",
      "english": "Good evening, Grandpa",
      "audioKey": "yo_kaale_baba_agba"
    },
    "se_iya": {
      "text": "Ẹ ṣé, ìyá",
      "english": "Thank you, Mum",
      "audioKey": "yo_se_iya"
    },
    "alaafia_baba": {
      "text": "Ṣé àlàáfíà ni, bàbá?",
      "english": "Are you well, Dad?",
      "audioKey": "yo_alaafia_baba"
    }
  },
