{
  "language": "yo",
  "lexicon": {
    "e_kaaro": {
      "text": "Ẹ káàárọ̀",
      "english": "Good morning",
      "audioKey": "yo_e_kaaro",
      "note": "Respectful: for parents, grandparents and anyone older."
    },
    "kaaro": {
      "text": "Káàárọ̀",
      "english": "Good morning (to a friend)",
      "audioKey": "yo_kaaro",
      "note": "Without the Ẹ, it's for friends, siblings your age and younger people."
    },
    "e_kaasan": {
      "text": "Ẹ káàsán",
      "english": "Good afternoon",
      "audioKey": "yo_e_kaasan"
    },
    "e_kaale": {
      "text": "Ẹ káalẹ́",
      "english": "Good evening",
      "audioKey": "yo_e_kaale"
    },
    "o_daaro": {
      "text": "Ó dàárọ̀",
      "english": "Good night",
      "audioKey": "yo_o_daaro",
      "note": "Literally “until the morning”."
    },
    "e_se": {
      "text": "Ẹ ṣé",
      "english": "Thank you",
      "audioKey": "yo_e_se",
      "note": "Respectful “thank you”, for elders."
    },
    "o_se": {
      "text": "O ṣé",
      "english": "Thank you (to a friend)",
      "audioKey": "yo_o_se",
      "note": "For friends and anyone younger than you."
    },
    "e_jowo": {
      "text": "Ẹ jọ̀wọ́",
      "english": "Please",
      "audioKey": "yo_e_jowo"
    },
    "e_ku_ise": {
      "text": "Ẹ kú iṣẹ́",
      "english": "Well done (for your work)",
      "audioKey": "yo_e_ku_ise",
      "note": "Said to someone who is working or has just finished. Yorùbá has a greeting for almost every situation."
    },
    "baba": {
      "text": "Bàbá",
      "english": "Father",
      "audioKey": "yo_baba"
    },
    "iya": {
      "text": "Ìyá",
      "english": "Mother",
      "audioKey": "yo_iya"
    },
    "baba_agba": {
      "text": "Bàbá àgbà",
      "english": "Grandfather",
      "audioKey": "yo_baba_agba",
      "note": "Literally “elder father”."
    },
    "iya_agba": {
      "text": "Ìyá àgbà",
      "english": "Grandmother",
      "audioKey": "yo_iya_agba",
      "note": "Literally “elder mother”."
    },
    "egbon": {
      "text": "Ẹ̀gbọ́n",
      "english": "Older sibling or cousin",
      "audioKey": "yo_egbon",
      "note": "Yorùbá cares more about who is older than about brother or sister."
    },
    "aburo": {
      "text": "Àbúrò",
      "english": "Younger sibling or cousin",
      "audioKey": "yo_aburo"
    },
    "beeni": {
      "text": "Bẹ́ẹ̀ni",
      "english": "Yes",
      "audioKey": "yo_beeni"
    },
    "rara": {
      "text": "Rárá",
      "english": "No",
      "audioKey": "yo_rara"
    },
    "se_alaafia_ni": {
      "text": "Ṣé àlàáfíà ni?",
      "english": "Are you well?",
      "audioKey": "yo_se_alaafia_ni"
    },
    "alaafia_ni": {
      "text": "Àlàáfíà ni",
      "english": "I'm well (all is well)",
      "audioKey": "yo_alaafia_ni"
    },
    "mo_wa_daadaa": {
      "text": "Mo wà dáadáa",
      "english": "I'm fine",
      "audioKey": "yo_mo_wa_daadaa"
    },
    "o_dabo": {
      "text": "Ó dàbọ̀",
      "english": "Goodbye",
      "audioKey": "yo_o_dabo"
    },
    "kaaro_iya_agba": {
      "text": "Ẹ káàárọ̀, ìyá àgbà",
      "english": "Good morning, Grandma",
      "audioKey": "yo_kaaro_iya_agba",
      "note": "Traditionally, girls and women kneel and boys and men bow or prostrate when greeting elders."
    },
    "kaale_baba_agba": {
      "text": "Ẹ káalẹ́, bàbá àgbà",
      "english": "Good evening, Grandpa",
      "audioKey": "yo_kaale_baba_agba"
    },
    "se_iya": {
      "text": "Ẹ ṣé, ìyá",
      "english": "Thank you, Mum",
      "audioKey": "yo_se_iya"
    },
    "alaafia_baba": {
      "text": "Ṣé àlàáfíà ni, bàbá?",
      "english": "Are you well, Dad?",
      "audioKey": "yo_alaafia_baba"
    },
    "oruko_re": {
      "text": "Kí ni orúkọ rẹ?",
      "english": "What's your name?",
      "note": "Casual: for friends, cousins your age and younger people.",
      "audioKey": "yo_oruko_re"
    },
    "oruko_yin": {
      "text": "Kí ni orúkọ yín?",
      "english": "What's your name? (respectful)",
      "note": "Yín is the respectful “your”, just as Ẹ is the respectful “you”.",
      "audioKey": "yo_oruko_yin"
    },
    "oruko_mi": {
      "text": "Orúkọ mi ni Túndé",
      "english": "My name is Túndé",
      "note": "Swap in your own name: Orúkọ mi ni …",
      "audioKey": "yo_oruko_mi"
    },
    "inu_mi_dun": {
      "text": "Inú mi dùn láti mọ̀ ọ́",
      "english": "Nice to meet you",
      "note": "Literally “my inside is sweet to know you”.",
      "audioKey": "yo_inu_mi_dun"
    },
    "omo_ta": {
      "text": "Ọmọ ta ni ọ́?",
      "english": "Whose child are you?",
      "note": "Elders often ask this before your name. Family is how people place you.",
      "audioKey": "yo_omo_ta"
    },
    "omo_adebayo": {
      "text": "Ọmọ Adébáyọ̀ ni mí",
      "english": "I am Adébáyọ̀'s child",
      "note": "Use your parent's or family name.",
      "audioKey": "yo_omo_adebayo"
    },
    "nibo_lo": {
      "text": "Níbo lo ti wá?",
      "english": "Where are you from?",
      "audioKey": "yo_nibo_lo"
    },
    "mo_n_gbe": {
      "text": "Mo ń gbé ní London",
      "english": "I live in London",
      "note": "Swap in your own city.",
      "audioKey": "yo_mo_n_gbe"
    },
    "se_o_gbo": {
      "text": "Ṣé o gbọ́ Yorùbá?",
      "english": "Do you understand Yorùbá?",
      "audioKey": "yo_se_o_gbo"
    },
    "mo_gbo_die": {
      "text": "Mo gbọ́ díẹ̀",
      "english": "I understand a little",
      "audioKey": "yo_mo_gbo_die"
    },
    "mo_n_ko": {
      "text": "Mo ń kọ́ èdè Yorùbá",
      "english": "I'm learning Yorùbá",
      "note": "Èdè means “language”.",
      "audioKey": "yo_mo_n_ko"
    },
    "soro_diediede": {
      "text": "Ẹ jọ̀wọ́, ẹ sọ̀rọ̀ díẹ̀díẹ̀",
      "english": "Please speak slowly",
      "audioKey": "yo_soro_diediede"
    },
    "tun_un_so": {
      "text": "Ẹ tún un sọ",
      "english": "Please say it again",
      "audioKey": "yo_tun_un_so"
    },
    "mo_fe_jeun": {
      "text": "Mo fẹ́ jẹun",
      "english": "I want to eat",
      "audioKey": "yo_mo_fe_jeun"
    },
    "e_je_ka_jeun": {
      "text": "Ẹ jẹ́ ká jẹun",
      "english": "Let's eat",
      "note": "A polite invitation to eat together.",
      "audioKey": "yo_e_je_ka_jeun"
    },
    "o_dun": {
      "text": "Ó dùn",
      "english": "It's delicious",
      "note": "Dùn means sweet, tasty or pleasant.",
      "audioKey": "yo_o_dun"
    },
    "mo_ti_yo": {
      "text": "Mo ti yó",
      "english": "I'm full",
      "audioKey": "yo_mo_ti_yo"
    },
    "omi": {
      "text": "Omi",
      "english": "Water",
      "audioKey": "yo_omi"
    },
    "e_kaabo": {
      "text": "Ẹ káàbọ̀",
      "english": "Welcome",
      "note": "What relatives will say when you arrive.",
      "audioKey": "yo_e_kaabo"
    },
    "e_jokoo": {
      "text": "Ẹ jókòó",
      "english": "Please sit down",
      "audioKey": "yo_e_jokoo"
    },
    "kaabo_iya": {
      "text": "Ẹ káàbọ̀, ìyá",
      "english": "Welcome, Mum",
      "audioKey": "yo_kaabo_iya"
    },
    "die_die": {
      "text": "Mo gbọ́ díẹ̀, mo ń kọ́ ọ",
      "english": "I understand a little, I'm learning it",
      "audioKey": "yo_die_die"
    }
  },
